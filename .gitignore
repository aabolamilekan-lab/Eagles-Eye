/prisma/*.db
/prisma/*.db-journal

# local object storage (development/test fallback for private uploads)
/.storage/

# editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# deployment
.vercel

