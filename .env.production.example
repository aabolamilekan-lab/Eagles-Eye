# Eagles Eye - Production Environment Variables Example Template
# Copy to your production environment (e.g. Vercel Project Settings). NEVER COMMIT REAL VALUES.
# All values below are placeholders and template examples - replace with actual production secrets.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string (server-only). Use production managed instance (e.g. Neon).
# For pooled providers (e.g. Neon) prefer the pooled endpoint. The app adds
# connection_limit/pool_timeout/connect_timeout when the URL omits them.
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?schema=public&sslmode=require"
# Optional driver tuning (only used when absent from DATABASE_URL).
# DATABASE_CONNECTION_LIMIT="10"
# DATABASE_POOL_TIMEOUT="20"
# DATABASE_CONNECT_TIMEOUT="15"

# --- Auth -----------------------------------------------------------------
# Session/HMAC signing secret, minimum 32 bytes of entropy (server-only)
# Generate: openssl rand -base64 32
AUTH_SECRET="<REDACTED_32_PLUS_CHAR_SECRET>"
# Session lifetime in seconds (7 days recommended)
SESSION_MAX_AGE_SECONDS="604800"

# --- App ------------------------------------------------------------------
# Public base URL for canonical URLs, Open Graph, sitemap
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- Storage (Cloudflare R2 / S3-compatible, private bucket) --------------
# ALL REQUIRED in production (server-only)
# For Cloudflare R2: endpoint is https://<account_id>.r2.cloudflarestorage.com, region is "auto"
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="<private-bucket-name>"
STORAGE_ACCESS_KEY_ID="<REDACTED_ACCESS_KEY>"
STORAGE_SECRET_ACCESS_KEY="<REDACTED_SECRET_KEY>"
# Set to "false" for Cloudflare R2 / AWS S3 virtual-hosted style ("true" for MinIO/path-style)
STORAGE_FORCE_PATH_STYLE="false"
# Do NOT set STORAGE_LOCAL_DIR in production

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_LOGIN_ATTEMPTS="5"
RATE_LIMIT_LOGIN_WINDOW_SECONDS="900"
RATE_LIMIT_WRITE_ACTIONS="60"
RATE_LIMIT_WRITE_WINDOW_SECONDS="60"
RATE_LIMIT_SEARCH_REQUESTS="60"
RATE_LIMIT_SEARCH_WINDOW_SECONDS="60"

# --- Uploads --------------------------------------------------------------
UPLOAD_MAX_BYTES="5242880"

# --- Node Environment -----------------------------------------------------
NODE_ENV="production"

# --- News Aggregation & AI Summarization (Phase 3.2) -----------------------
# Bearer secret token required to authorize /api/cron/aggregate (server-only)
# Generate: openssl rand -base64 32 (minimum 16 characters required)
CRON_SECRET="<REDACTED_16_PLUS_CHAR_SECRET>"
# Google Gemini API key for server-side factual summarization (server-only)
GEMINI_API_KEY="<REDACTED_GEMINI_API_KEY>"
# Configured Gemini model identifier (defaults to "gemini-3.5-flash-lite")
GEMINI_MODEL="gemini-3.5-flash-lite"
# Automated publishing toggle. Must remain "false" in production so all imported
# articles enter the editorial review queue as drafts.
NEWS_AUTO_PUBLISH="false"

# --- Seed (NEVER set in production) ---------------------------------------
# SEED_ADMIN_EMAIL - must NOT be set
# SEED_ADMIN_PASSWORD - must NOT be set

# --- First-administrator bootstrap (one-shot, never at runtime) -----------
# Consumed only by `npm run admin:create` to create the first ADMIN account
# (or with `--update` to rotate an existing account's password). The
# application never reads these variables at boot, so after the account
# exists, clear them. The password must be at least 12 characters.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_NAME="Site Admin"          # optional; defaults to the email local part
# ADMIN_PASSWORD="<REDACTED_STRONG_PASSWORD>"
