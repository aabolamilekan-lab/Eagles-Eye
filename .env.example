# ---------------------------------------------------------------------------
# Eagles Eye environment contract
# Copy to .env and fill in real values. Never commit .env.
# Anything prefixed with NEXT_PUBLIC_ is shipped to the browser.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Server-only. Replace user/password for your machine.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eagles_eye?schema=public"

# --- Auth -----------------------------------------------------------------
# Session / HMAC signing secret, 32+ bytes of entropy. Server-only.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Absolute session lifetime in seconds (e.g. 604800 = 7 days).
SESSION_MAX_AGE_SECONDS="604800"

# --- App ------------------------------------------------------------------
# Public base URL. Used for canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage (S3-compatible, private bucket) ------------------------------
# Server-only. Used to read/write story covers.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="eagles-eye-covers"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Optional: force path-style addressing for MinIO and similar providers.
STORAGE_FORCE_PATH_STYLE="true"
# Development/test only: filesystem fallback used when the S3 values above are
# absent. Relative paths resolve against the project root. Never used in
# production, which requires the S3 values instead.
STORAGE_LOCAL_DIR=""

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_LOGIN_ATTEMPTS="5"
RATE_LIMIT_LOGIN_WINDOW_SECONDS="900"
RATE_LIMIT_WRITE_ACTIONS="60"
RATE_LIMIT_WRITE_WINDOW_SECONDS="60"
# Public search per-IP ceiling.
RATE_LIMIT_SEARCH_REQUESTS="60"
RATE_LIMIT_SEARCH_WINDOW_SECONDS="60"

# --- Uploads --------------------------------------------------------------
UPLOAD_MAX_BYTES="5242880"

# --- Seed (local development only) ----------------------------------------
# Documentation placeholders only. Set your own in the gitignored .env. Never
# used in production; seed refuses to run against a production database.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-locally"